# Copy to supabase/.env (git-ignored) and fill in. Never commit the real file.
# URL and publishable key: Supabase dashboard > Project Settings > API Keys. Same values as mobile/src/core/config.ts.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The shared moderator account (seed.mjs and tests/rls-check.mjs).
MODERATOR_EMAIL=
MODERATOR_PASSWORD=

# One of your personal (regular) accounts (tests/rls-check.mjs).
REGULAR_EMAIL=
REGULAR_PASSWORD=
